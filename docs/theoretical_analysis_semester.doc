{\rtf1\ansi\deff0{\fonttbl{\f0 Calibri;}{\f1 Consolas;}}\viewkind4\uc1\fs22\par\pard\sa240\b\fs32 \u1058?\u1077?\u1086?\u1088?\u1077?\u1090?\u1080?\u1095?\u1077?\u1089?\u1082?\u1080?\u1081? \u1072?\u1085?\u1072?\u1083?\u1080?\u1079? (\u1087?\u1088?\u1080?\u1083?\u1086?\u1078?\u1077?\u1085?\u1080?\u1077? \u1082? \u1086?\u1090?\u1095?\u1077?\u1090?\u1091?)\b0\fs22\par\par\pard\sa120 \{\\b \u1055?\u1088?\u1086?\u1077?\u1082?\u1090?:\} \u1074?\u1077?\u1073?-\u1087?\u1088?\u1080?\u1083?\u1086?\u1078?\u1077?\u1085?\u1080?\u1077? \u1076?\u1083?\u1103? \u1088?\u1072?\u1085?\u1085?\u1077?\u1075?\u1086? \u1089?\u1082?\u1088?\u1080?\u1085?\u1080?\u1085?\u1075?\u1072? \u1056?\u1040?\u1057? \u1087?\u1086? eye-tracking \u1095?\u1077?\u1088?\u1077?\u1079? \u1074?\u1077?\u1073?-\u1082?\u1072?\u1084?\u1077?\u1088?\u1091?\par\pard\sa120 \{\\b \u1057?\u1090?\u1077?\u1082?:\} Python / FastAPI / OpenCV / MediaPipe / PyTorch\par\pard\sa120 \{\\b \u1056?\u1086?\u1083?\u1100?:\} ML Engineer / Computer Vision Engineer\par\pard\sa120 \{\\b \u1060?\u1086?\u1082?\u1091?\u1089? \u1072?\u1085?\u1072?\u1083?\u1080?\u1079?\u1072?:\} \u1090?\u1088?\u1080? \u1075?\u1080?\u1087?\u1086?\u1090?\u1077?\u1079?\u1099? (features vs raw, stimulus-invariance, cross-device robustness) \u1080? \u1086?\u1073?\u1097?\u1072?\u1103? \u1087?\u1088?\u1086?\u1073?\u1083?\u1077?\u1084?\u1072?\u1090?\u1080?\u1082?\u1072? \u1080?\u1079?\u1084?\u1077?\u1088?\u1077?\u1085?\u1080?\u1081? \u1080? \u1092?\u1086?\u1082?\u1091?\u1089?\u1072? \u1074?\u1085?\u1080?\u1084?\u1072?\u1085?\u1080?\u1103?.\par\par\par\pard\sa200\qc\emdash\emdash\emdash\emdash\emdash\emdash\emdash\emdash\par\pard\sa200\par\par\pard\sa220\b\fs28 1) \u1054?\u1073?\u1097?\u1072?\u1103? \u1087?\u1088?\u1086?\u1073?\u1083?\u1077?\u1084?\u1072?\u1090?\u1080?\u1082?\u1072? (\u1086?\u1073?\u1098?\u1077?\u1076?\u1080?\u1085?\u1077?\u1085?\u1085?\u1072?\u1103? \u1076?\u1083?\u1103? \u1074?\u1089?\u1077?\u1093? \u1075?\u1080?\u1087?\u1086?\u1090?\u1077?\u1079?)\b